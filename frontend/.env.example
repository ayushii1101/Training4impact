# Copy this file to .env and fill in real values.
# NEVER commit .env files. Real credentials live only in your local .env or the
# hosting provider's secret manager.

# ---------------------------------------------------------------
# DEVELOPMENT / TEST
# ---------------------------------------------------------------

# Backend API base URL used by the frontend to call the payment API.
# Development fallback is http://localhost:5000 (see src/utils/payments.js).
VITE_API_URL=http://localhost:5000

# Public Razorpay Key ID — TEST MODE key while testing.
# This is a PUBLIC identifier. NEVER put RAZORPAY_KEY_SECRET in the frontend.
VITE_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------
# PRODUCTION
# ---------------------------------------------------------------

# Public Razorpay Key ID — LIVE MODE key. Set only in the production build.
# VITE_API_URL=https://api.your-production-domain.com
# VITE_RAZORPAY_KEY_ID=your-live-mode-public-key-id