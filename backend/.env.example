# Copy this file to .env and fill in real values.
# NEVER commit .env files. Real credentials live only in your local .env or the
# hosting provider's secret manager.

# ---------------------------------------------------------------
# DEVELOPMENT / TEST (Razorpay Test Mode)
# ---------------------------------------------------------------

# Razorpay public key id for the payment API (Test Mode from the dashboard).
RAZORPAY_KEY_ID=

# Razorpay secret key for the payment API (Test Mode). Backend only — never expose to the frontend.
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret used to verify payment.captured / payment.failed /
# order.paid webhook signatures. Configured in Razorpay Dashboard -> Settings ->
# Webhooks. Backend only.
RAZORPAY_WEBHOOK_SECRET=

# HTTP port the backend listens on. Leave empty to use the default (5000).
PORT=

# Comma-separated list of allowed frontend origins for CORS (no wildcard).
# Development default when unset: http://localhost:5173
CORS_ORIGIN=

# Optional: override the SQLite database file path.
DB_PATH=

# ---------------------------------------------------------------
# PRODUCTION (Razorpay Live Mode)
# ---------------------------------------------------------------

# Use separate Live Mode credentials from the Razorpay dashboard.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Set the port required by your hosting provider (e.g. 8080).
# PORT=
# Allow ONLY your production frontend origin(s).
# CORS_ORIGIN=https://your-production-frontend-domain.com